{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benavt/structure-atlas-registry/schemas/project-registry.schema.json",
  "title": "Structure Atlas Project Registry (Linked-List Roster)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "repository",
    "canonical_site",
    "targets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "canonical_site": { "type": "string", "pattern": "^https://" },
    "access_mode": {
      "type": "string",
      "enum": ["private", "public"],
      "description": "Cloudflare Pages access state. Collaborator email allowlists live solely in Cloudflare Zero Trust Access, never in GitHub."
    },
    "demo_site": { "type": ["string", "null"] },
    "staged_targets": {
      "type": "array",
      "description": "Pre-release targets live on this project's Zero Trust Access-protected Cloudflare Pages site prior to Zenodo Production DOI graduation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "display_name",
          "status",
          "model_count",
          "structure_clustering_ref",
          "target_url"
        ],
        "properties": {
          "target_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
          "display_name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pre_release", "sandbox_draft"] },
          "model_count": { "type": "integer", "minimum": 1 },
          "structure_clustering_ref": { "type": "string", "minLength": 1 },
          "target_url": { "type": "string", "pattern": "^https://" },
          "zenodo_sandbox_url": { "type": ["string", "null"] },
          "residue_scopes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "release_version",
          "zenodo_version_doi",
          "target_url",
          "prev_target_id",
          "next_target_id"
        ],
        "properties": {
          "target_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
          "release_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "zenodo_concept_doi": {
            "type": ["string", "null"],
            "pattern": "^10\\.(5281|5072)/zenodo\\.[0-9]+$"
          },
          "zenodo_version_doi": { "type": "string", "pattern": "^10\\.(5281|5072)/zenodo\\.[0-9]+$" },
          "target_url": { "type": "string", "pattern": "^https://" },
          "prev_target_id": { "type": ["string", "null"] },
          "next_target_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
